# ---- Root-level env (copied to .env) ----
# Used by concurrently / scripts; per-app env lives in client/.env and server/.env

# Client (Vite)
VITE_API_URL=http://localhost:5000/api/v1

# Server
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
MONGO_URI=mongodb://127.0.0.1:27017/zaminex

# JWT
JWT_ACCESS_SECRET=replace-with-long-random-string
JWT_REFRESH_SECRET=replace-with-another-long-random-string
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Seed admin (created by `npm run seed`)
SEED_ADMIN_NAME=Platform Admin
SEED_ADMIN_EMAIL=admin@zaminex.local
SEED_ADMIN_PASSWORD=ChangeMe!2024
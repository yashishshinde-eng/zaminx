# Server environment — copy to server/.env and edit
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
MONGO_URI=mongodb://127.0.0.1:27017/zaminex

# JWT — generate with: openssl rand -hex 32  (must be >= 32 chars)
JWT_ACCESS_SECRET=change-me-to-a-32-plus-char-random-secret-value
JWT_REFRESH_SECRET=change-me-to-a-different-32-plus-char-secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Seed admin (created by `npm run seed`). Required — no default.
SEED_ADMIN_NAME=Platform Admin
SEED_ADMIN_EMAIL=admin@zaminex.local
SEED_ADMIN_PASSWORD=Set-a-strong-admin-password!

# Email (Phase 3). In dev, leave SMTP_HOST unset to use the file transport
# (outbound mail is written to server/logs/emails/ instead of sent).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Zaminex <noreply@zaminex.io>
EMAIL_TOKEN_EXPIRY_HOURS=24